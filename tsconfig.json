{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "useDefineForClassFields": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "src/imapflow.d.ts"]
}
